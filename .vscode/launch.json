{
    "version": "0.2.0",
    "configurations": [
        /* ───── Client ───── */
        {
            "name": "Frontend Dev Server",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}/frontend",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "serverReadyAction": {
                "pattern": "Local:\\s+(https?://[^/]+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        /* ───── Server ───── */
        {
            "name": "Debug Server",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=server",
                    "--package=links"
                ],
                "filter": {
                    "name": "server",
                    "kind": "bin"
                },
                "cwd": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/config/local.env",
            "env": {
                /* "RUST_LOG": "debug", */
                "RUST_BACKTRACE": "1"
            },
            "args": [],
            "preLaunchTask": "cargo:build",
            "stopOnEntry": false
        },
        {
            "name": "Test All Tests",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=links",
                    "--",
                    "--nocapture"
                ],
                "filter": {
                    "name": "links",
                    "kind": "lib"
                },
                "cwd": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug",
                "RUST_BACKTRACE": "1"
            },
            "args": [],
            "stopOnEntry": false
        },
        {
            "name": "Release Server",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--release",
                    "--bin=server",
                    "--package=links"
                ],
                "filter": {
                    "name": "server",
                    "kind": "bin"
                },
                "cwd": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/config/local.env",
            "env": {
                "RUST_LOG": "info",
                "RUST_BACKTRACE": "0"
            },
            "args": [],
            "preLaunchTask": "cargo:build",
            "stopOnEntry": false
        },
        {
            "name": "Debug Specific Test",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "${input:testName}",
                    "--package=links",
                    "--no-run"
                ],
                "filter": {
                    "name": "links",
                    "kind": "lib"
                },
                "cwd": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug",
                "RUST_BACKTRACE": "1"
            },
            "args": [
                "--nocapture"
            ],
            "stopOnEntry": false
        }
    ],
    "inputs": [
        {
            "id": "testName",
            "description": "Enter test name to debug",
            "default": "test_",
            "type": "promptString"
        }
    ]
}